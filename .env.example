# QueryCampus Configuration Environment Variables

# Ollama Settings (Default local hosting)
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_EMBED_MODEL=nomic-embed-text
OLLAMA_LLM_MODEL=orca-mini

# Groq Cloud API Settings (Optional cloud acceleration)
GROQ_API_KEY=
GROQ_MODEL=llama-3.1-8b-instant

# Chroma Vector Store Settings
CHROMA_PERSIST_DIRECTORY=./chroma_db
CHROMA_COLLECTION_NAME=university_documents

# RAG Hyperparameters (from IEEE GITCON 2025 Paper)
CHUNK_SIZE=800
CHUNK_OVERLAP=80
TOP_K=2
SIMILARITY_METRIC=cosine
MAX_HISTORY_TURNS=3

# UI Configuration
STREAMLIT_SERVER_PORT=8501
STREAMLIT_SERVER_HEADLESS=true
