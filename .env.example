# ==============================================================================
# QueryCampus Environment Configuration
# ==============================================================================

# Ollama Local Service
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_EMBED_MODEL=nomic-embed-text
OLLAMA_LLM_MODEL=orca-mini

# Groq Cloud API (Optional for sub-second cloud inference)
GROQ_API_KEY=
GROQ_MODEL=llama-3.1-8b-instant

# Chroma Vector Store
CHROMA_PERSIST_DIRECTORY=./chroma_db
CHROMA_COLLECTION_NAME=campus_documents

# RAG Hyperparameters
CHUNK_SIZE=800
CHUNK_OVERLAP=80
TOP_K=2

# Data Directory
SAMPLE_DOCS_DIR=./data/sample_docs

# Streamlit Configuration
STREAMLIT_SERVER_PORT=8501
STREAMLIT_SERVER_HEADLESS=true

# Supabase Cloud RBAC & Identity Integration
SUPABASE_URL=https://your-project-ref.supabase.co
SUPABASE_KEY=your-supabase-anon-or-publishable-key

